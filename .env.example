# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ============================================================
# Firebase Auth
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON key.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Leave blank on Cloud Run — GCP provides credentials automatically.
FIREBASE_SERVICE_ACCOUNT_KEY=./your-firebase-adminsdk-key.json

# ============================================================
# Claude / Anthropic
# ============================================================
# Required for AI-powered agents (Smart Grocery, Recipe Finder, Meal Planner).
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ============================================================
# Google Cloud Vision
# ============================================================
# Required for receipt scanning (OCR).
# Create an API key at: https://console.cloud.google.com/apis/credentials
# Enable the "Cloud Vision API" on your project first.
GCV_API_KEY=

# ============================================================
# Instacart Connect API
# ============================================================
# Required for the Smart Grocery agent to search products and build carts.
# Register at: https://connect.instacart.com/developer
INSTACART_API_KEY=

# Webhook secret — set in your Instacart developer dashboard under Webhooks.
# Used to verify incoming order.delivered events.
INSTACART_WEBHOOK_SECRET=

# ============================================================
# Instacart TypeScript service (internal)
# ============================================================
# The Node.js service that wraps the Instacart Connect API.
# In local dev this runs on port 3001 alongside the FastAPI server.
INSTACART_SERVICE_URL=http://localhost:3001

# Shared secret for service-to-service calls between FastAPI and the TS service.
# Set the same value in the TS service environment.
INSTACART_SERVICE_KEY=
